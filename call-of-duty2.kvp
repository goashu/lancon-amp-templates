Meta.DisplayName=Call of Duty 2 (2005) - Windows LAN
Meta.Description=Manual-install Call of Duty 2 multiplayer dedicated LAN server; runtime verification pending
Meta.OS=Windows
Meta.Arch=x86_64
Meta.Author=LANCON
Meta.URL=https://github.com/goashu/lancon-amp-templates
Meta.DisplayImageSource=steam:2630
Meta.EndpointURIFormat=
Meta.ConfigManifest=call-of-duty2config.json
Meta.MetaConfigManifest=call-of-duty2metaconfig.json
Meta.ConfigRoot=call-of-duty2.kvp
Meta.MinAMPVersion=2.8.0.8
Meta.SpecificDockerImage=
Meta.DockerRequired=False
Meta.ContainerPolicy=NotSupported
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=[]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=1
Meta.AppConfigId=06a68acf-b97e-4cb0-b92c-3901dc7a1344
Meta.AppIsMultiIPAware=True
App.DisplayName=Call of Duty 2
App.RootDir=./call-of-duty2/
App.BaseDirectory=./call-of-duty2/
App.ExecutableWin=CoD2MP_s.exe
App.ExecutableLinux=
App.WorkingDir=./
App.CommandLineArgs=+set dedicated 1 +set net_ip {{$ApplicationIPBinding}} +set net_port {{$GamePort}} +set sv_maxclients {{$MaxUsers}} +exec lancon.cfg +map_rotate
App.AppSettings={"sv_hostname":"LANCON CoD2","g_gametype":"tdm","sv_mapRotation":"map mp_toujane map mp_carentan map mp_burgundy map mp_dawnville","g_password":""}
App.EnvironmentVariables={}
App.ExitMethod=WM_CLOSE
App.ExitTimeout=30
App.HasWriteableConsole=False
App.HasReadableConsole=False
App.SupportsLiveSettingsChanges=False
App.SupportsIPv6=False
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[call-of-duty2ports.json]
App.PrimaryApplicationPortRef=GamePort
App.MaxUsers=32
App.UseRandomAdminPassword=False
App.RemoteAdminPassword=
App.AdminMethod=STDIO
App.UpdateSources=@IncludeJson[call-of-duty2updates.json]
App.PreStartStages=[]
App.Compatibility=None
App.SteamUpdateAnonymousLogin=False
App.SteamForceLoginPrompt=False
App.RapidStartup=False
App.MonitorChildProcess=False
App.SupportsUniversalSleep=False
App.ApplicationReadyMode=Immediate
Console.AppReadyRegex=^$
Console.UserJoinRegex=^$
Console.UserLeaveRegex=^$
Console.UserChatRegex=^$
Console.MetricsRegex=
Console.UserActions={}
Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.AutoRetryCount=0
